{
  "name": "arcadia-zombies",
  "compatibility_date": "2026-10-01",
  "main": "functions/worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "kv_namespaces": [
    { "binding": "RUNS" }
  ],
  "routes": [
    { "pattern": "arcadiaworlds.com", "custom_domain": true },
    { "pattern": "www.arcadiaworlds.com", "custom_domain": true },
    { "pattern": "zombies.arcadiaworlds.com", "custom_domain": true }
  ]
}

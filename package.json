{
  "name": "arcadia-zombies",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . && node scripts/pack-atlas.mjs && node scripts/check-pack.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "size": "node scripts/size.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "smoke": "playwright test",
    "ci": "npm run lint && npm run typecheck && npm run test && npm run build && npm run size && npm run smoke",
    "playtest": "vitest run test/playtest.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.20.5",
    "eslint": "^9.14.0",
    "terser": "^5.36.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
